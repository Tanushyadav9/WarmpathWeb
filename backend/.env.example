# WarmPath Backend Environment Configuration Template
# Copy this file to .env and configure values for your environment.

# Application
ENVIRONMENT=development
PORT=8000
APP_SECRET_KEY=change-this-insecure-app-secret-key-32chars-min
JWT_SECRET=change-this-insecure-jwt-secret-key-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
CSRF_SECRET=change-this-insecure-csrf-secret-key-32chars-min
SECURITY_HEADERS_ENABLED=true
CSRF_PROTECTION_ENABLED=true

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:///warmpath.db
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & File Uploads
MAX_UPLOAD_SIZE_BYTES=5242880
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=100

# SMTP / Email OTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@warmpath.org

# External APIs
GEMINI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEMO_PAYMENT_MODE=true
JITSI_BASE_URL=https://meet.jit.si
